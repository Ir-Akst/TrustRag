# TrustRAG Deployment Environment Variables

# Server Configuration
TRUSTRAG_HOST=127.0.0.1
TRUSTRAG_PORT=8000
TRUSTRAG_ENV=production
TRUSTRAG_FRONTEND_DIR=frontend
TRUSTRAG_AUDIT_LOG=logs/audit_events.jsonl

# Security & API Authentication
# If set, mutations (config update) require Bearer token. In development, defaults to unauthenticated local dev.
TRUSTRAG_API_TOKEN=
TRUSTRAG_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Verification & Neural NLI Model Checkpoint
# Default path to frozen DeBERTa-v3-small NLI fine-tuned model
TRUSTRAG_VERIFICATION_NLI_BACKEND=hybrid
TRUSTRAG_VERIFICATION_NLI_MODEL_PATH=/home/aditya/rags/models/trained/deberta-v3-small-nli-phase11_1-full3epoch
TRUSTRAG_VERIFICATION_CONTRADICTION_THRESHOLD=0.20
TRUSTRAG_VERIFICATION_ENTAILMENT_THRESHOLD=0.50

# SRM (Small Reasoning Model) Configuration
TRUSTRAG_SRM_ENABLED=true
TRUSTRAG_SRM_BACKEND=neural_nli
TRUSTRAG_SRM_MODEL_NAME=/home/aditya/rags/models/trained/deberta-v3-small-nli-phase11_1-full3epoch

# G1 Input Guardrail Configuration
TRUSTRAG_GUARDRAILS_ENABLED=true
TRUSTRAG_GUARDRAILS_BLOCK_THRESHOLD=0.85

# G2 Multi-Signal Detector (MSD)
TRUSTRAG_MSD_ENABLED=true
TRUSTRAG_MSD_TRUST_THRESHOLD=0.50

# Log Level
TRUSTRAG_LOG_LEVEL=INFO

