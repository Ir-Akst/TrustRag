{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "G3CanonicalClaimGraph",
  "description": "Closed canonical schema for G3 atomic claim graphs",
  "type": "object",
  "required": ["graph_id", "claim_text", "nodes", "edges", "is_passive", "unknown_agent"],
  "additionalProperties": false,
  "properties": {
    "graph_id": {
      "type": "string",
      "pattern": "^clm_graph_[a-zA-Z0-9_-]+$"
    },
    "claim_text": {
      "type": "string",
      "minLength": 1
    },
    "is_passive": {
      "type": "boolean"
    },
    "unknown_agent": {
      "type": "boolean"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["node_id", "node_type", "text"],
        "additionalProperties": false,
        "properties": {
          "node_id": {
            "type": "string",
            "pattern": "^n_[a-zA-Z0-9_-]+$"
          },
          "node_type": {
            "type": "string",
            "enum": ["entity", "predicate", "quantity", "temporal", "condition", "modifier"]
          },
          "text": {
            "type": "string"
          },
          "is_unknown": {
            "type": "boolean"
          },
          "attributes": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["edge_id", "source_id", "target_id", "relation"],
        "additionalProperties": false,
        "properties": {
          "edge_id": {
            "type": "string",
            "pattern": "^e_[a-zA-Z0-9_-]+$"
          },
          "source_id": {
            "type": "string",
            "pattern": "^n_[a-zA-Z0-9_-]+$"
          },
          "target_id": {
            "type": "string",
            "pattern": "^n_[a-zA-Z0-9_-]+$"
          },
          "relation": {
            "type": "string",
            "enum": [
              "subject_of",
              "object_of",
              "agent_of",
              "patient_of",
              "quantifies",
              "temporally_bounds",
              "conditions",
              "modifies",
              "coordinates_with"
            ]
          },
          "attributes": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  }
}

