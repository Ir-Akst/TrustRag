{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "G3CanonicalEvidenceGraph",
  "description": "Closed canonical schema for G3 evidence graphs and grounding structures",
  "type": "object",
  "required": ["graph_id", "evidence_id", "document_id", "passage_text", "provenance", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "graph_id": {
      "type": "string",
      "pattern": "^evd_graph_[a-zA-Z0-9_-]+$"
    },
    "evidence_id": {
      "type": "string"
    },
    "document_id": {
      "type": "string"
    },
    "passage_text": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "required": ["source", "timestamp", "trust_level", "signature_verified"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string" },
        "timestamp": { "type": "string" },
        "trust_level": { "type": "string", "enum": ["TRUSTED", "UNCERTAIN", "UNTRUSTED"] },
        "signature_verified": { "type": "boolean" },
        "key_id": { "type": "string" }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["node_id", "node_type", "text"],
        "additionalProperties": false,
        "properties": {
          "node_id": { "type": "string", "pattern": "^en_[a-zA-Z0-9_-]+$" },
          "node_type": { "type": "string", "enum": ["entity", "predicate", "quantity", "temporal", "condition", "modifier"] },
          "text": { "type": "string" },
          "span": {
            "type": "array",
            "items": { "type": "integer" },
            "minItems": 2,
            "maxItems": 2
          },
          "attributes": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["edge_id", "source_id", "target_id", "relation"],
        "additionalProperties": false,
        "properties": {
          "edge_id": { "type": "string", "pattern": "^ee_[a-zA-Z0-9_-]+$" },
          "source_id": { "type": "string", "pattern": "^en_[a-zA-Z0-9_-]+$" },
          "target_id": { "type": "string", "pattern": "^en_[a-zA-Z0-9_-]+$" },
          "relation": {
            "type": "string",
            "enum": [
              "subject_of",
              "object_of",
              "agent_of",
              "patient_of",
              "quantifies",
              "temporally_bounds",
              "conditions",
              "modifies",
              "coordinates_with"
            ]
          },
          "attributes": { "type": "object", "additionalProperties": true }
        }
      }
    }
  }
}

